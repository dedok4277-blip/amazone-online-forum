<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Amazone Online</title>
  <link rel="preload" href="/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/webfonts/fa-regular-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fa.min.css?v=2">
  <link rel="stylesheet" href="/css/style.css?v=2">
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="logo">
    </a>

    <!-- Nav -->
    <nav class="main-nav">
      <a href="/" class="nav-link">Главная</a>

      <div class="nav-item">
        <span class="nav-link">Форумы <i class="fa fa-caret-down caret"></i></span>
        <div class="dropdown">
          <a href="/"><i class="fa fa-th-list"></i> Все форумы</a>
          <div class="dropdown-sep"></div>
          <div class="dropdown-label">Найти темы</div>
          <a href="/search?type=my">Мои темы</a>
          <a href="/search?type=participated">Темы с моими сообщениями</a>
          <a href="/search?type=unanswered">Темы без ответов</a>
          <div class="dropdown-sep"></div>
          <div class="dropdown-label">Отслеживаемое</div>
          <a href="/search?type=watched">Отслеживаемые темы</a>
          <div class="dropdown-sep"></div>
          <a href="/search">Поиск сообщений</a>
        </div>
      </div>

      <div class="nav-item">
        <span class="nav-link">Что нового? <i class="fa fa-caret-down caret"></i></span>
        <div class="dropdown">
          <a href="/new-posts">Новые сообщения</a>
          <a href="/new-posts">Рекомендуемый контент</a>
          <a href="/new-posts">Новые сообщения профилей</a>
        </div>
      </div>

      <div class="nav-item">
        <span class="nav-link">Пользователи <i class="fa fa-caret-down caret"></i></span>
        <div class="dropdown">
          <a href="/members">Все пользователи</a>
          <a href="/members">Новые пользователи</a>
          <a href="/members">Поиск пользователей</a>
        </div>
      </div>
    </nav>

    <!-- User area -->
    <div class="nav-user">
      <% if (currentUser) { %>
        <div class="nav-item">
          <button class="user-avatar-btn">
            <img src="<%= currentUser.avatar || '/img/default-avatar.svg' %>" alt="<%= currentUser.username %>">
          </button>
          <div class="user-popup">
            <div class="user-popup-head">
              <img src="<%= currentUser.avatar || '/img/default-avatar.svg' %>" alt="<%= currentUser.username %>">
              <div>
                <div class="user-popup-name"><%= currentUser.username %></div>
                <div class="user-popup-role">
                  <span class="user-role role-<%= currentUser.role %>"><%= currentUser.roleLabel || currentUser.role %></span>
                </div>
              </div>
            </div>
            <div class="user-popup-links">
              <a href="/user/<%= currentUser.id %>"><i class="fa fa-user"></i> Профиль</a>
              <a href="/user/<%= currentUser.id %>/edit"><i class="fa fa-bookmark"></i> Закладки</a>
              <a href="/user/<%= currentUser.id %>/edit"><i class="fa fa-info-circle"></i> Информация</a>
              <a href="/user/<%= currentUser.id %>/edit"><i class="fa fa-shield"></i> Безопасность</a>
              <a href="/user/<%= currentUser.id %>/edit"><i class="fa fa-gear"></i> Настройки</a>
              <% if (currentUser.role === 'admin' || (currentUser.perms && currentUser.perms.canAccessAdmin)) { %>
                <a href="/admin"><i class="fa fa-screwdriver-wrench"></i> Админ панель</a>
              <% } %>
            </div>
            <div class="user-popup-logout">
              <form action="/auth/logout" method="POST">
                <button type="submit">Выход</button>
              </form>
            </div>
          </div>
        </div>
      <% } else { %>
        <a href="/auth/login" class="btn-nav-login">Войти</a>
        <a href="/auth/register" class="btn-nav-reg">Регистрация</a>
      <% } %>
    </div>
  </div>
</header>

<main class="container main-wrap">
  <% if (success) { %>
    <div class="alert alert-success"><i class="fa fa-circle-check"></i> <%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><i class="fa fa-circle-xmark"></i> <%= error %></div>
  <% } %>
  <%- body %>
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-brand-name">Amazone Online</div>
      <div>Официальный форум сообщества</div>
    </div>
    <div class="footer-links">
      <a href="#">Обратная связь</a>
      <a href="#">Условия и правила</a>
      <a href="#">Политика конфиденциальности</a>
      <a href="#">Помощь</a>
      <a href="/">Главная</a>
    </div>
    <div class="footer-right">
      Community platform<br>
      &copy; <%= new Date().getFullYear() %> Amazone Online
    </div>
  </div>
</footer>

<script src="/js/main.js?v=2"></script>
</body>
</html>
