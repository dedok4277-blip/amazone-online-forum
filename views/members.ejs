<div class="page-title-bar"><h1>Пользователи</h1></div>
<div class="thread-list-wrap">
  <% for (const u of users) { %>
    <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--border);">
      <img src="<%= u.avatar||'/img/default-avatar.svg' %>" style="width:38px;height:38px;border-radius:50%;object-fit:cover;">
      <div style="flex:1">
        <a href="/user/<%= u.id %>" style="font-weight:600;font-size:13px;color:var(--text)"><%= u.username %></a>
        <div style="font-size:11px;color:var(--text-muted)">Сообщений: <%= u.post_count %> &middot; <%= new Date(u.created_at).toLocaleDateString('ru') %></div>
      </div>
      <span class="user-role role-<%= u.role %>"><%= u.role === 'admin' ? 'Админ' : u.role === 'moderator' ? 'Мод' : 'Игрок' %></span>
    </div>
  <% } %>
</div>
