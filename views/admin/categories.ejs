<div class="admin-layout">
  <%- include('_sidebar') %>
  <div class="admin-content">
    <h1>Категории</h1>

    <div class="admin-form-box">
      <h2>Добавить категорию</h2>
      <form action="/admin/categories/create" method="POST" class="inline-form">
        <input type="text" name="name" placeholder="Название" required>
        <input type="text" name="description" placeholder="Описание">
        <input type="number" name="display_order" placeholder="Порядок" value="0" style="width:80px">
        <button type="submit" class="btn-primary">Добавить</button>
      </form>
    </div>

    <table class="admin-table">
      <thead>
        <tr><th>#</th><th>Название</th><th>Описание</th><th>Порядок</th><th>Действия</th></tr>
      </thead>
      <tbody>
        <% for (const c of categories) { %>
          <tr>
            <td><%= c.id %></td>
            <td>
              <form action="/admin/categories/<%= c.id %>/edit" method="POST" class="inline-edit-form">
                <input type="text" name="name" value="<%= c.name %>" required>
                <input type="text" name="description" value="<%= c.description || '' %>">
                <input type="number" name="display_order" value="<%= c.display_order %>" style="width:60px">
                <button type="submit" class="btn-xs">Сохранить</button>
              </form>
            </td>
            <td><%= c.description || '—' %></td>
            <td><%= c.display_order %></td>
            <td>
              <form action="/admin/categories/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Удалить?')" style="display:inline">
                <button class="btn-xs btn-danger"><i class="fa fa-trash"></i></button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
