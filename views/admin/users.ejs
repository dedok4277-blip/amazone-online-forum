<div class="admin-layout">
  <%- include('_sidebar') %>
  <div class="admin-content">
    <h1>Пользователи</h1>
    <table class="admin-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Логин</th>
          <th>Email</th>
          <th>Роль</th>
          <th>Постов</th>
          <th>Статус</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% for (const u of users) { %>
          <tr class="<%= u.is_banned ? 'row-banned' : '' %>">
            <td><%= u.id %></td>
            <td><a href="/user/<%= u.id %>"><%= u.username %></a></td>
            <td style="font-size:12px;color:var(--text-muted)"><%= u.email %></td>
            <td>
              <% if (canAssign) { %>
                <form action="/admin/users/<%= u.id %>/role" method="POST" style="display:inline">
                  <select name="role" onchange="this.form.submit()" class="role-select">
                    <% for (const r of assignableRoles) { %>
                      <option value="<%= r.key %>" <%= u.role === r.key ? 'selected' : '' %>><%= r.label %></option>
                    <% } %>
                  </select>
                </form>
              <% } else { %>
                <span class="user-role role-<%= u.role %>"><%= ROLE_LABELS[u.role] || u.role %></span>
              <% } %>
            </td>
            <td><%= u.post_count %></td>
            <td>
              <% if (u.is_banned) { %>
                <span class="badge-banned">Заблокирован</span>
              <% } else { %>
                <span class="badge-ok">Активен</span>
              <% } %>
            </td>
            <td class="action-btns">
              <% if (canBan) { %>
                <form action="/admin/users/<%= u.id %>/ban" method="POST" style="display:inline">
                  <button class="btn-xs <%= u.is_banned ? '' : 'btn-warning' %>">
                    <%= u.is_banned ? 'Разблокировать' : 'Заблокировать' %>
                  </button>
                </form>
              <% } %>
              <% if (canDelete) { %>
                <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display:inline"
                      onsubmit="return confirm('Удалить пользователя?')">
                  <button class="btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
