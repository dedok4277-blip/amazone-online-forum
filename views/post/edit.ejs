<div class="form-page">
  <h1>Редактировать сообщение</h1>
  <form action="/post/<%= post.id %>/edit" method="POST">
    <div class="form-group">
      <label>Текст</label>
      <textarea name="content" rows="10" required><%= post.content %></textarea>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn-primary"><i class="fa fa-floppy-disk"></i> Сохранить</button>
      <a href="/thread/<%= post.thread_id %>" class="btn-secondary">Отмена</a>
    </div>
  </form>
</div>
